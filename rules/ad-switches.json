      "back": "{n}",
      "key": "{name: home/back/enter}",
      "scroll": "{forward, times}",
      "gesture": "{preset: pull_down/pull_down_short/swipe_right/swipe_left}",
      "switches": "{off: [...], keep: [...], all: true, page: 说明}",
      "confirm": "点确定/开启类按钮",
      "dismiss": "点取消/暂不/跳过类按钮"
